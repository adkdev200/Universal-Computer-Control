# Universal Computer MCP - environment configuration example
# Copy to `.env` (or export in your shell / MCP client config).
#
# The server supports two kinds of environment variables:
#   1. UCC_* overrides for any config value, using `__` as the nesting delimiter.
#      Values are parsed as YAML scalars (true/false, ints, lists in JSON form).
#   2. Plain variables referenced BY NAME from config (e.g. the VLM API key).

# --- Config overrides (examples; nesting uses `__`) -------------------------
# UCC_ENGINE__OBSERVATION_LEVEL=normal
# UCC_ENGINE__VERIFY_ACTIONS=true
# UCC_ENGINE__VERIFICATION_MODE=basic        # off | basic | strict
# UCC_INPUT__FAILSAFE=true
# UCC_SECURITY__MODE=standard                # permissive | standard | strict
# UCC_SECURITY__ALLOWED_COMMANDS=["xdotool","wmctrl","ls"]
# UCC_SECURITY__ALLOW_SHELL=false
# UCC_LOGGING__LEVEL=INFO
# UCC_PERSISTENCE__HOME=/home/you/.universal-computer
# UCC_VISION__VLM__ENABLED=false

# --- Secrets referenced by config (do NOT put secrets in config.yaml) ------
# API key for the optional vision-language model provider:
VLM_API_KEY=
